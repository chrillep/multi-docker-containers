{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "labels": [
    "dependencies"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "commitMessageAction": "⬆️ Bump",
  "extends": [
    "config:best-practices",
    "schedule:weekly",
    ":dependencyDashboard"
  ],
  "commitMessageTopic": "{{depName}}",
  "forkProcessing": "enabled",
  "prConcurrentLimit": 1,
  "rebaseWhen": "never",
  "packageRules": [
    {
      "matchCategories": [
        "php"
      ],
      "addLabels": [
        "php"
      ]
    },
    {
      "matchCategories": [
        "js"
      ],
      "addLabels": [
        "javascript"
      ]
    },
    {
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin"
      ]
    },
    {
      "groupName": "Bud",
      "schedule": [
        "at any time"
      ],
      "matchPackageNames": [
        "@roots/{/,}**"
      ]
    },
    {
      "groupName": "Alpine.js",
      "matchPackageNames": [
        "alpinejs{/,}**",
        "@alpinejs/{/,}**"
      ]
    },
    {
      "matchManagers": [
        "npm"
      ],
      "addLabels": [
        "npm"
      ]
    },
    {
      "matchManagers": [
        "composer"
      ],
      "addLabels": [
        "composer"
      ],
      "rangeStrategy": "bump"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "major"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "addLabels": [
        "minor"
      ]
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "addLabels": [
        "patch"
      ]
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "addLabels": [
        "docker"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "addLabels": [
        "github_actions"
      ]
    }
  ],
  "timezone": "Europe/Stockholm"
}
